# Copy to .env and fill in. Never commit .env.

# --- Flower-served models (Endeavor, openai/gpt-5.6-sol, ...) ---
# flower.ai -> Profile -> Settings -> API Keys
# Used by SuperNodes / a local SuperLink as the upstream model provider.
FLWR_MODEL_API_KEY=

# --- Nebius Token Factory (from Slack #hackathon_stanford_2026) ---
# Set on the SuperNodes that use Nebius models: FLWR_MODEL_API_ENDPOINT=$NEBIUS_MODEL_API_ENDPOINT
# and FLWR_MODEL_API_KEY=<that model's key>. Each model has its own key.
NEBIUS_MODEL_API_ENDPOINT=https://api.tokenfactory.tf-ca1.nebius.com/v1/responses
NEBIUS_KIMI_MODEL_ID=dedicated/flowerai/Kimi-K2.7-Code-1OUHWL
NEBIUS_KIMI_API_KEY=
NEBIUS_MINIMAX_MODEL_ID=dedicated/flowerai/MiniMax-M3-OOLI9o
NEBIUS_MINIMAX_API_KEY=

# --- Models ---
COORDINATOR_MODEL=flwrlabs/endeavor-1.0
FALLBACK_MODEL=openai/gpt-5.6-sol

# --- Flower Chat connection (supergrid | local-agent) ---
FLWR_CHAT_SUPERLINK=supergrid

# --- BlindQuote bureau attestation key (generate: python -c "import secrets;print(secrets.token_hex(32))") ---
BUREAU_HMAC_KEY=
